<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core.xsd
                            http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext.xsd">
    <service>
        <jsr107:defaults enable-management="true" />
    </service>
    <cache alias="trending" uses-template="short-lived" />
    <cache-template name="short-lived">
        <expiry>
            <ttl unit="minutes">2</ttl>
        </expiry>
        <resources>
            <heap unit="entries">250</heap>
        </resources>
    </cache-template>
</config>
